import { NextRequest, NextResponse } from "next/server"
import { getEvent, getEventPhotos, getRecipientsForEvent, upsertEvent } from "@/lib/irstudiolive/store"

export const runtime = "nodejs"

export async function GET(req: NextRequest) {
  try {
    const eventId = req.nextUrl.searchParams.get("eventId")?.trim() || ""
    const limitRaw = Number(req.nextUrl.searchParams.get("limit") || "80")
    const limit = Number.isFinite(limitRaw) ? Math.max(1, Math.min(500, limitRaw)) : 80

    if (!eventId) {
      return NextResponse.json({ ok: false, error: "Missing eventId" }, { status: 400 })
    }

    const event = getEvent(eventId) ?? upsertEvent({ id: eventId })
    const photos = getEventPhotos(eventId).slice(0, limit)
    const recipients = getRecipientsForEvent(eventId)

    return NextResponse.json({
      ok: true,
      event,
      photos,
      recipients,
      totalPhotos: photos.length,
      totalRecipients: recipients.length,
    })
  } catch (error) {
    return NextResponse.json(
      { ok: false, error: String(error) },
      { status: 500 }
    )
  }
}
